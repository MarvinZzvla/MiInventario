<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".FeedbackPage">



    <TextView
        android:id="@+id/headingFeedbackText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reporta un problema o sugerencia"
        android:background="#11141B"
        android:gravity="center"
        android:textSize="30sp"
        android:fontFamily="@font/mairyextrabold"
        android:padding="10dp"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="#11141B"
        app:layout_constraintTop_toBottomOf="@+id/headingFeedbackText"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="20sp"
        app:layout_constraintVertical_bias="0.1">

        <TextView
            android:id="@+id/infoText_feebackPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="La aplicación esta creciendo rapidamente y estamos desarrollando
nuevas funcionalidades y mejoras constantemente, porfavor ayudanos en el proceso con un comentario"/>

        <EditText
            android:id="@+id/suggestText_feedbackPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:hint="Reportar un problema o una sugerencia"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/infoText_feebackPage" />

        <Button
            android:id="@+id/btnSubmitFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_background"
            android:fontFamily="@font/mairyextrabold"
            android:text="Enviar"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/suggestText_feedbackPage"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>