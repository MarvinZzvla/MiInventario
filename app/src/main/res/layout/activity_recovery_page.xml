<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".RecoveryPage">

    <TextView
        android:id="@+id/textRecovery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mairyextrabold"
        android:text="Recuperar cuenta"
        android:textColor="@color/white"
        android:textSize="48sp"
        app:layout_constraintVertical_bias="0.05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewRecovery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/mairyextrabold"
        android:text="Ingresa tu usuario, telefono o PIN"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.1"
        app:layout_constraintTop_toBottomOf="@+id/textRecovery" />

    <EditText
        android:id="@+id/editTextRecovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:fontFamily="@font/mairyextralight"
        android:background="@drawable/edit_text_background"
        android:inputType="text"
        android:hint="Ingresa tu usuario,telefono o PIN"
        android:padding="20dp"
        android:textSize="20sp"
        app:layout_constraintVertical_bias="0"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewRecovery" />


    <Button
        android:id="@+id/btnRecovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:padding="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.05"
        android:fontFamily="@font/mairyextrabold"
        android:textSize="20sp"
        android:text="Recuperar"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/button_danger_bg"
        app:layout_constraintTop_toBottomOf="@+id/editTextRecovery" />

    <TextView
        android:id="@+id/displayInfdRecovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/btnRecovery"
        android:padding="10dp"
        android:layout_margin="20dp"
        android:textSize="30dp"
        android:visibility="gone"
        android:textColor="@color/white"
        android:fontFamily="@font/mairyextrabold"
        app:layout_constraintVertical_bias="0.1"
        android:text=""
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>